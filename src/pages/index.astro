---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 自动获取所有文章
const allPosts = await getCollection('posts');
const title = "Automation Library | Home";
const description = "Discover the best workflows for n8n, Zapier, and AI-driven automation.";
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <h1>Mastering the Art of Automation</h1>
    <p>The ultimate library of high-impact, low-code workflows for modern business.</p>
  </string>
  </section>

  <section class="post-list">
    <h2>Latest Workflows</h2>
    <ul>
      {allPosts.map(post => (
        <li>
          <a href={`/posts/${post.slug}/`}>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="date">{post.data.pubDate.toLocaleDateString()}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero { padding: 3rem 0; text-align: center; background: #f8fafc; border-radius: 12px; margin-bottom: 2rem; }
  .hero h1 { font-size: 2.5rem; margin: bottom: 1rem; }
  .post-list ul { list-style: none; padding: 0; }
  .post-list li { margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #e5e7eb; border-radius: 8px; transition: 0.2s; }
  .post-list li:hover { border-color: #2563eb; transform: translateY(-2px); }
  .post-list h3 { margin: 0 0 0.5rem 0; font-size: 1.25rem; }
  .post-list p { color: #6b7280; margin: 0 0 0.5rem 0; font-size: 0.9rem; }
  .date { font-size: 0.8rem; color: #9ca3af; }
</style>